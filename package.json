{
  "name": "ai-browser-agent",
  "description": "通用 AI 浏览器智能体:在任意网页通过 AI 自主操作 DOM 完成自动化任务",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:chrome": "wxt build -b chrome",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "zip:chrome": "wxt zip -b chrome",
    "zip:edge": "wxt zip -b edge",
    "build:all": "wxt zip -b chrome && wxt zip -b edge && node scripts/generate-update-xml.mjs",
    "gen:update-xml": "node scripts/generate-update-xml.mjs",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0",
    "wxt": "^0.21.4"
  }
}
